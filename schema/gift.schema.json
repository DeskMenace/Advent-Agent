{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/suchipizza/Advent-Agent/main/schema/gift.schema.json",
  "title": "Advent Agent gift manifest (gift.json)",
  "description": "Manifest of a gift package submitted to an Advent Agent calendar. See AGENT_GUIDE.md. The agent never purchases or books anything; realWorld entries are proposals.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "advent-agent/gift@1"
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "subtitle": {
      "type": "string",
      "maxLength": 300
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "primary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artifacts": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "download",
              "asset",
              "thumbnail",
              "print",
              "transcript",
              "caption"
            ]
          },
          "alt": {
            "type": "string",
            "maxLength": 1000
          },
          "mime": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "path",
          "kind"
        ]
      }
    },
    "song": {
      "type": "object",
      "properties": {
        "score": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "renderSheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "wav": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "score"
      ]
    },
    "realWorld": {
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "vendor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "price": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "notes": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "name",
              "vendor",
              "url",
              "checkedAt"
            ]
          }
        },
        "whatsLeft": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "items",
        "whatsLeft"
      ]
    },
    "links": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ]
      }
    },
    "network": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "incomplete": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "continuity": {
      "type": "object",
      "properties": {
        "thread": {
          "type": "string",
          "maxLength": 80
        },
        "motifs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "schema",
    "day",
    "title",
    "note"
  ]
}
