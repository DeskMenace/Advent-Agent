{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/suchipizza/Advent-Agent/main/schema/gift.schema.json",
  "title": "Advent Agent gift manifest (gift.json)",
  "description": "Manifest of a gift package submitted to an Advent Agent calendar. See AGENT_GUIDE.md. The agent never purchases or books anything; realWorld entries are proposals.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "advent-agent/gift@1",
        "advent-agent/gift@2"
      ]
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "subtitle": {
      "type": "string",
      "maxLength": 300
    },
    "note": {
      "type": "string",
      "maxLength": 8000
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "save": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "file",
        "type"
      ]
    },
    "primary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artifacts": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "download",
              "asset",
              "thumbnail",
              "print",
              "transcript",
              "caption"
            ]
          },
          "alt": {
            "type": "string",
            "maxLength": 1000
          },
          "mime": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "path",
          "kind"
        ]
      }
    },
    "song": {
      "type": "object",
      "properties": {
        "score": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "renderSheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "wav": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "score"
      ]
    },
    "realWorld": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "vendor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  },
                  "checkedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "name",
                  "vendor",
                  "url",
                  "checkedAt"
                ]
              }
            },
            "whatsLeft": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "items"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "links": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ]
      }
    },
    "network": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "incomplete": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "continuity": {
      "type": "object",
      "properties": {
        "thread": {
          "type": "string",
          "maxLength": 80
        },
        "motifs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ideaId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "type": "string",
      "maxLength": 60
    },
    "emotion": {
      "type": "string",
      "enum": [
        "funny",
        "ridiculous",
        "absurd",
        "cute",
        "touching"
      ]
    },
    "interaction": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      ]
    },
    "form": {
      "type": "string",
      "maxLength": 40
    },
    "tierUsed": {
      "type": "string",
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "collection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "set": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "size": {
              "default": 3,
              "type": "integer",
              "minimum": 2,
              "maximum": 3
            }
          },
          "required": [
            "set",
            "index"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "share": {
      "type": "object",
      "properties": {
        "still": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "object",
              "properties": {
                "capture": {
                  "type": "string",
                  "const": "still"
                }
              },
              "required": [
                "capture"
              ]
            }
          ]
        },
        "loop": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "object",
              "properties": {
                "capture": {
                  "type": "string",
                  "const": "loop"
                },
                "durationMs": {
                  "default": 6000,
                  "type": "integer",
                  "minimum": 3000,
                  "maximum": 10000
                }
              },
              "required": [
                "capture"
              ]
            }
          ]
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "privateText": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "still"
      ]
    },
    "downloads": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "label",
          "file"
        ]
      }
    },
    "print": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "product": {
            "type": "string",
            "maxLength": 200
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "shipsTo": {
            "type": "string",
            "maxLength": 120
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "service",
          "url"
        ]
      }
    },
    "credits": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "what",
          "source",
          "license"
        ]
      }
    }
  },
  "required": [
    "schema",
    "day",
    "title"
  ]
}
